{
  "manifest_version": 3,
  "name": "Finite Scroll",
  "version": "1.13.0",
  "description": "Bring back natural stops to Instagram, YouTube, and LinkedIn, with a private daily dashboard.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Finite Scroll",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "login-content.js",
        "core.js",
        "content.js",
        "usage.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "youtube-policy.js",
        "youtube.js",
        "usage.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "linkedin-policy.js",
        "linkedin.js",
        "usage.js"
      ],
      "css": [
        "linkedin.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://*.instagram.com/*"
  ]
}
